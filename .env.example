# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose

# Public URL of this deployment (used in pay links and auth emails)
NEXT_PUBLIC_SITE_URL=https://nyumbapay.co.ke

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# M-Pesa C2B (leave MPESA_ENABLED=false until Daraja go-live)
MPESA_ENABLED=false
# Random string you append to the callback URLs you register with Daraja:
#   https://<site>/api/mpesa/c2b/confirmation?secret=<value>
MPESA_CALLBACK_SECRET=
# Optional: comma-separated Safaricom callback IPs to allow (empty = allow all, rely on secret)
MPESA_ALLOWED_IPS=
